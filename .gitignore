.thumbnails/
**/.thumbnails/
previews/
**/previews/

# IMPORTANT: NOT IGNORED
# .env and .env.*
# *.json, *.yaml, *.yml, *.xml, *.toml, *.ini, *.conf, *.config
# *.properties, *.key, *.pem, *.crt, *.cer
# firebase.json, .firebaserc, google-services.json
# package.json, package-lock.json, yarn.lock, pnpm-lock.yaml
# Gradle configuration, source code, SQL/data files and maintained files
