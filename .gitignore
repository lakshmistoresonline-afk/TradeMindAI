# GLOBAL GITIGNORE
# Ignore runtime-generated, build, cache, dependency and OS artifacts.
# Keep source code, configuration, data, JSON/YAML/XML, lock files and keys.

# Node.js / JavaScript
node_modules/
**/node_modules/
.npm/
.yarn/cache/
.yarn/unplugged/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.heapsnapshot

# JS framework/build/cache
.next/cache/
.nuxt/cache/
.svelte-kit/cache/
.angular/cache/
.vite/
.parcel-cache/
.webpack-cache/
.rollup.cache/
.cache/
**/.cache/
dist/
**/dist/
out/
**/out/
build/
**/build/
storybook-static/
.astro/

# React Native / Expo / Metro
.expo/
.expo-shared/
.metro/
.metro-cache/
**/.gradle/
**/.cxx/
*.apk
*.aab

# Android / Gradle
.gradle/
**/captures/
*.hprof

# iOS / Xcode
